# Single-container "monolith" variant: app + Redis in the same container.
# Anti-pattern (violates one-process-per-container) kept here deliberately,
# as the baseline the multi-container architecture is compared against.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends redis-server \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/main.py app/load_data.py app/entrypoint-monolith.sh ./
COPY app/static ./static
RUN chmod +x entrypoint-monolith.sh

COPY data/movies.csv data/ratings_sample.csv /data/
ENV DATA_DIR=/data
ENV REDIS_HOST=localhost

EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=5 \
    CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health', timeout=2)" || exit 1

CMD ["./entrypoint-monolith.sh"]
